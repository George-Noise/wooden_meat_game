@box from (0, 0, 0) to (1, 0.5, 1) {
    @part tags (top) texture "blocks:turret_belt_top"
    @part tags (bottom) texture "blocks:belt_bottom"
    @part tags (west) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (east) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (north) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (south) texture "blocks:belt_side" region(0, 0, 1, 1)
}

@box from (0.0625, 0.5, 0.0625) to (0.125, 0.875, 0.125) texture "blocks:metal"
@box from (0.875, 0.5, 0.0625) to (0.9375, 0.875, 0.125) texture "blocks:metal"
@box from (0.0625, 0.5, 0.875) to (0.125, 0.875, 0.9375) texture "blocks:metal"
@box from (0.875, 0.5, 0.875) to (0.9375, 0.875, 0.9375) texture "blocks:metal"
