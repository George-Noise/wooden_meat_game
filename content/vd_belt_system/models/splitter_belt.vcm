@box from (0, 0, 0) to (1, 0.5, 1) {
    @part tags (top) texture "blocks:splitter_belt_top"
    @part tags (bottom) texture "blocks:belt_bottom"
    @part tags (west) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (east) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (north) texture "blocks:belt_side" region(0, 0, 1, 1)
    @part tags (south) texture "blocks:belt_side" region(0, 0, 1, 1)
}
